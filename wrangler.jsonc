{
  // Cloudflare Worker that serves the built site from ./dist.
  // Production uses `wrangler deploy`; Worker Previews use `wrangler preview`.
  // Keep this file as the source of truth for both paths.
  "name": "tembobot",
  "compatibility_date": "2026-09-01",
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "previews": {}
}
